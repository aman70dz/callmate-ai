# Safe local development defaults. Live calls stay disabled until explicitly enabled.
NODE_ENV=development
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
APP_BASE_URL=https://YOUR_PUBLIC_HTTPS_HOST

# demo | supabase
DATA_MODE=demo

# Google Gemini API (used for text generation & call planning)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TEXT_MODEL=gemini-3-flash-preview

# Gemini Multimodal Live (used for real-time bidirectional audio streaming)
GEMINI_REALTIME_MODEL=models/gemini-2.5-flash-native-audio-latest
GEMINI_REALTIME_VOICE=Puck

# Telephony provider: twilio | exotel
TELEPHONY_PROVIDER=twilio

# Twilio credentials (Free trial supported)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_trial_phone_number

# Exotel India credentials
EXOTEL_BASE_URL=https://api.in.exotel.com
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=

# Supabase (required when DATA_MODE=supabase)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Redis (required for durable retry scheduling / worker)
REDIS_URL=redis://127.0.0.1:6379

# Explicit kill switch. Keep false until consent, provider access, and testing are complete.
ENABLE_LIVE_CALLS=false
