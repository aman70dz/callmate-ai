{
  "name": "callmate-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal AI calling assistant with Google Gemini and Exotel",
  "scripts": {
    "dev": "node --watch backend/src/server.js",
    "start": "node backend/src/server.js",
    "worker": "node backend/src/workers/callWorker.js",
    "test": "node tests/runAllTests.mjs",
    "check": "node --check backend/src/server.js && node --check backend/src/websocket/voiceBridge.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@supabase/supabase-js": "^2.57.0",
    "axios": "^1.11.0",
    "bullmq": "^5.58.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "form-data": "^4.0.4",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  }
}
